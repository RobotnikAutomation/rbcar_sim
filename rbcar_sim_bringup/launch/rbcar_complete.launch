<?xml version="1.0"?>
<launch>

  <!-- GPS default position of Robotnik at Fuente del Jarro-->
  <arg name="gps_latitude" default="39.5080331" />
  <arg name="gps_longitude" default="-0.4619816" />
  <arg name="has_camera" default="true"/>
  <arg name="world_name" default="plane" />

  <!-- Frames -->
  <arg name="base_frame" default="robot_base_footprint"/>
  <arg name="odom_frame" default="robot_odom"/>
  <arg name="global_frame" default="map"/>

  <!-- Topics -->
  <!-- Localization -->
  <arg name="map_topic" default="/map"/>
  <arg name="odom_topic" default="/odom"/>

  <!-- Description -->
  <include file="$(find rbcar_description)/launch/rbcar_state_robot.launch">
    <arg name="gps_latitude" value="$(arg gps_latitude)"/>
    <arg name="gps_longitude" value="$(arg gps_longitude)"/>
  </include>

  <!-- Gazebo Simulation -->
  <include file="$(find rbcar_gazebo)/launch/rbcar_gazebo.launch">
    <arg name="world_name" value="$(arg world_name)" />
    <arg name="has_camera" value="$(arg has_camera)"/>
  </include>

  <!-- Control -->
  <include file="$(find rbcar_control)/launch/rbcar_control_alternative.launch">
  </include>
  
  <!-- Fake Localization. -->
  <!-- Gazebo publishes odom-base_link -->
  <node name="fake_localization" pkg="fake_localization" type="fake_localization" respawn="false">
    <param name="odom_frame_id" value="$(arg odom_frame)"/>
    <param name="global_frame_id" value="$(arg global_frame)"/>
    <param name="base_frame_id" value="$(arg base_frame)"/>
    <!-- Remap of subscribed topic-->
    <remap from="base_pose_ground_truth" to="$(arg odom_topic)"/>
  </node>

  <!-- Map Server -->
  <arg name="map_file" default="$(find rbcar_sim_bringup)/config/localization/maps/empty.yaml"/>
  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)">
          <param name="frame_id" value="$(arg global_frame)"/>
          <param name="map_file" value="$(arg map_file)"/>
          <remap from="map" to="$(arg map_topic)"/>
  </node>

  <!-- Navigation -->
  <include file="$(find rbcar_sim_bringup)/launch/navigation/move_base_flex.launch">
    <arg name="base_frame" value="$(arg base_frame)"/>
    <arg name="odom_frame" value="$(arg odom_frame)"/>
    <arg name="global_frame" value="$(arg global_frame)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="config_package" value="rbcar_sim_bringup"/>
    <arg name="config_folder" value="config/navigation/move_base"/>
  </include>

  <!-- RVIZ -->
  <node type="rviz" name="rviz" pkg="rviz" args="-d $(find rbcar_sim_bringup)/config/rviz/default.rviz"/>

</launch>
